{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:x/U/i0e2Q4M3Vw3x1wQ0jX1e6L5a4S3d2F1g0H9j8K7=",
    "APP_URL": "https://katar1205.vercel.app",
    "ASSET_URL": "https://katar1205.vercel.app",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}
